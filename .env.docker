# Docker Compose Environment Variables
# Copy this file to .env before running docker-compose

# Node Environment
NODE_ENV=production

# PostgreSQL Configuration
POSTGRES_DB=clientpro_crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=4000
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Frontend Configuration
FRONTEND_PORT=3000

# API URLs — usadas como build ARGs en el Dockerfile del frontend
# NEXT_PUBLIC_* vars se bakean en el bundle JS durante next build.
# Con nginx en puerto 80, el browser accede al API via /api/ (sin puerto).
# REST API pasa por nginx: /api/* → backend:4000 (sin prefijo /api/)
NEXT_PUBLIC_API_URL=http://localhost/api
# Socket.io necesita el root del servidor (nginx maneja /socket.io/)
NEXT_PUBLIC_SOCKET_URL=http://localhost

# NextAuth — apunta al root de nginx (puerto 80) para callbacks y cookies
NEXTAUTH_URL=http://localhost
NEXTAUTH_SECRET=your-super-secret-nextauth-key-change-in-production-min-32-chars
